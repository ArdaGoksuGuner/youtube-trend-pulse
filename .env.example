# Copy this file to .env and fill in your values
# Never commit .env to version control

# YouTube Data API v3 — Google Cloud Console → APIs & Services → Credentials → API key
YOUTUBE_API_KEY=

# Anthropic — claude.ai/settings — used for theme synthesis
ANTHROPIC_API_KEY=

# Gmail — Google Account → Security → 2-Step Verification → App Passwords
# Use the 16-char App Password, not your Gmail login password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Recipient of the trend report (defaults to GMAIL_ADDRESS if blank)
REPORT_RECIPIENT=

# Google OAuth — for YouTube subscriptions + Slides + Drive
# Download OAuth client (Desktop type) from GCP and save as credentials.json at project root
# token.json is generated by tools/setup_oauth.py on first run
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Niche search queries (comma-separated). Tune to your interests.
NICHE_QUERIES=AI agents,AI automation,Claude AI,GPT agents,n8n workflow,LangChain tutorial,AI tools 2026,Make.com automation
